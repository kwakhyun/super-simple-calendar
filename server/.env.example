# Server
PORT=4000
NODE_ENV=development

# SQLite database file (defaults to ./data/calendar.db).
# Fly.io production uses /data/calendar.db via fly.toml.
DB_PATH=./data/calendar.db

# JWT signing secret. REQUIRED in production, min 16 chars.
JWT_SECRET=change-me-to-a-long-random-string

# CORS: comma-separated allowed origins. Empty/unset allows all in development.
ALLOWED_ORIGINS=

# Public URL of this server (used for OAuth callbacks, e.g. Kakao redirect)
SERVER_URL=http://localhost:4000

# Mobile app deep-link scheme used to return OAuth results to the app
APP_SCHEME=supersimplecalendar

# --- Email (Resend). If RESEND_API_KEY is unset, codes are logged to console. ---
RESEND_API_KEY=
EMAIL_FROM=Simple Calendar <onboarding@resend.dev>

# --- Google OAuth ---
# No server secret needed: the app sends a Google access token that we verify.

# --- Apple Sign In ---
APPLE_BUNDLE_ID=com.torinana.supersimplecalendar

# --- Kakao OAuth (server-side authorization-code flow) ---
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
